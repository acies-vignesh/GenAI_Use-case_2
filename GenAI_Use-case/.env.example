# App database (the engine's own memory). Defaults to <project>/data/app.db
# APP_DB_URL=sqlite:///C:/path/to/app.db

# DEVELOPER ONLY: default source for the command-line tool (the demo DB). Real users connect
# their sources through the UI connection form; those details are stored encrypted in the app DB.
# SOURCE_DB_URL=sqlite:///C:/path/to/source.db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Any OpenAI-compatible endpoint. Examples:
#   Groq   : https://api.groq.com/openai/v1   model e.g. openai/gpt-oss-120b, qwen/qwen3.8-27b
#   Ollama : http://localhost:11434/v1        model e.g. llama3.1  (fully local, key can be any text)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TEMPERATURE=0.2

SAMPLE_ROW_LIMIT=10000
# Keep false: only aggregated profile stats (no raw rows) go to the LLM
SEND_RAW_SAMPLES_TO_LLM=false
