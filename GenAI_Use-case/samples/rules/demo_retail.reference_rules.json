{
  "source_id": "demo_retail",
  "description": "Steward-written reference rules for the demo DB. 'covers' maps each rule to the planted issue(s) it catches. Answer key for scoring generated rules - never shown to the engine.",
  "rules": [
    {
      "covers": [
        "PI-001"
      ],
      "rule": {
        "source_id": "demo_retail",
        "name": "Region parent must be one level up",
        "category": "hierarchy",
        "dimension": "consistency",
        "scope": "table",
        "target": {
          "entity": "region",
          "columns": []
        },
        "check": {
          "type": "hierarchy_parent_level",
          "hierarchy": "geography"
        },
        "severity": "high",
        "origin": "steward",
        "status": "approved"
      }
    },
    {
      "covers": [
        "PI-002"
      ],
      "rule": {
        "source_id": "demo_retail",
        "name": "Region parent must exist",
        "category": "data_quality",
        "dimension": "referential_integrity",
        "scope": "cross_table",
        "target": {
          "entity": "region",
          "columns": [
            "parent_region_id"
          ]
        },
        "check": {
          "type": "foreign_key",
          "ref_entity": "region",
          "ref_columns": [
            "region_id"
